# ─── Database ───────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/handrix"

# ─── JWT ────────────────────────────────────────────────────────────────────
# Secret for signing access tokens (min 32 chars recommended)
JWT_SECRET="change-me-in-production"
# Access token lifetime (e.g. 15m, 1h)
JWT_EXPIRES_IN="15m"
# Secret for signing refresh tokens (different from JWT_SECRET)
JWT_REFRESH_SECRET="change-me-refresh-secret"
# Refresh token lifetime
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Stripe ─────────────────────────────────────────────────────────────────
# Stripe secret key (sk_live_... for production, sk_test_... for dev)
STRIPE_SECRET_KEY="sk_test_placeholder"
# Stripe webhook signing secret (from Stripe dashboard → Webhooks)
STRIPE_WEBHOOK_SECRET="whsec_placeholder"

# ─── Google Maps ─────────────────────────────────────────────────────────────
# Required for live transport cost calculation (leave empty to use stub)
GOOGLE_MAPS_API_KEY=""

# ─── Materials API ───────────────────────────────────────────────────────────
# Vendor not yet selected — leave empty to use stub with default cost
MATERIALS_API_KEY=""
# Default material cost returned by stub (USD)
DEFAULT_MATERIAL_COST="20"

# ─── Transport (stub fallback) ───────────────────────────────────────────────
# Default transport cost returned by Maps stub (USD)
DEFAULT_TRANSPORT_COST="10"

# ─── Gemini LLM (Chat Assist) ────────────────────────────────────────────────
# Google AI Studio API key — leave empty to disable AI chat assist
# Get your key at: https://aistudio.google.com/app/apikey
# Model used: gemini-2.5-flash
GEMINI_API_KEY=""

# ─── Warranty ────────────────────────────────────────────────────────────────
# Number of days a warranty is valid after job completion
WARRANTY_PERIOD_DAYS="30"

# ─── App ────────────────────────────────────────────────────────────────────
PORT="3000"
